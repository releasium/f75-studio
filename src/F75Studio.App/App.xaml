<Application x:Class="F75Studio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:F75Studio.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Views/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NotNullVisible" />
            <conv:NullToVisibilityConverter x:Key="NullVisible" Invert="True" />
            <conv:EnumMatchToVisibilityConverter x:Key="EnumMatch" />
            <conv:RgbToBrushConverter x:Key="RgbBrush" />
            <BooleanToVisibilityConverter x:Key="BoolVisible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

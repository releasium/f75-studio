<ui:FluentWindow x:Class="F75Studio.App.PomodoroWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:F75Studio.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:PomodoroViewModel}"
                 Title="Pomodoro timer" Width="360" Height="470" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen" Topmost="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="FocusBrush" Color="#E5383B" />
        <SolidColorBrush x:Key="RestBrush" Color="#2F6BFF" />
        <Style x:Key="PhaseColored" TargetType="FrameworkElement">
            <Setter Property="Tag" Value="{StaticResource FocusBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFocus}" Value="False">
                    <Setter Property="Tag" Value="{StaticResource RestBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Pomodoro timer" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="24,8,24,20" x:Name="Root" Style="{StaticResource PhaseColored}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding Tag, ElementName=Root}" />
                <TextBlock Text="{Binding PhaseText}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{Binding Tag, ElementName=Root}" />
            </StackPanel>
            <TextBlock Text="{Binding TimeText}" FontSize="64" FontWeight="Light" HorizontalAlignment="Center"
                       Margin="0,4,0,8" FontFamily="Segoe UI Variable Display, Segoe UI" />
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6"
                         Foreground="{Binding Tag, ElementName=Root}" />
            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7" FontSize="12">
                <Run Text="Focus periods done: " /><Run Text="{Binding CompletedFocus, Mode=OneWay}" />
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <ui:Button Appearance="Primary" Width="96" Content="{Binding StartPauseText}" Command="{Binding StartPauseCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Skip" Command="{Binding SkipCommand}" Icon="{ui:SymbolIcon Next24}" Margin="0,0,8,0" />
                <ui:Button Content="Reset" Command="{Binding ResetCommand}" Icon="{ui:SymbolIcon ArrowReset24}" />
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Focus (minutes)" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding FocusMinutes, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Rest (minutes)" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding RestMinutes, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Grid>
            <TextBlock Margin="0,14,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Keyboard: red while focusing, blue while resting; F1–F12 show the time left. Needs the USB cable. Closing this window stops the timer." />
        </StackPanel>
    </Grid>
</ui:FluentWindow>

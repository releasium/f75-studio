<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\F75Studio.Core\F75Studio.Core.csproj" />
    <ProjectReference Include="..\F75Studio.Hotkeys\F75Studio.Hotkeys.csproj" />
    <ProjectReference Include="..\F75Studio.Lighting\F75Studio.Lighting.csproj" />
    <ProjectReference Include="..\F75Studio.Lighting.Aula\F75Studio.Lighting.Aula.csproj" />
    <InternalsVisibleTo Include="F75Studio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" NoWarn="NU1701" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>F75Studio</AssemblyName>
    <RootNamespace>F75Studio.App</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\AutoHotkey.xshd" LogicalName="AutoHotkey.xshd" />
  </ItemGroup>

</Project>
